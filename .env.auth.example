# Copy to .env.auth. Never commit the populated file.
# Generate each role value with: python -c "import secrets; print(secrets.token_urlsafe(48))"
ZASLON_ALICE_API_KEY=replace-with-a-unique-random-alice-key-at-least-32-characters
ZASLON_BOB_API_KEY=replace-with-a-unique-random-bob-key-at-least-32-characters
ZASLON_ATTACK_API_KEY=replace-with-a-unique-random-attack-key-at-least-32-characters

# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ZASLON_JOB_PAYLOAD_KEY=replace-with-a-fernet-key

# Independent server-side HMAC key used to attest exported QDS artifacts.
ZASLON_ARTIFACT_ATTESTATION_KEY=replace-with-a-unique-random-attestation-key-at-least-32-characters
