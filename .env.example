# =============================================================================
# ZASLON-QDS Configuration Template
# =============================================================================

# --- Primary Docker MySQL configuration ---
# Copy this file to .env and replace every placeholder. The application account
# is deliberately not root.
ZASLON_DB_NAME=zaslon_qds
ZASLON_DB_USER=zaslon_app
ZASLON_DB_PASSWORD=replace-with-a-strong-application-database-password
ZASLON_DB_ROOT_PASSWORD=replace-with-a-different-strong-root-password

# --- Optional host-native/manual debug database configuration ---
MYSQL_USER=zaslon_app
MYSQL_PASSWORD=replace-with-the-application-database-password
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=zaslon_qds

# Role API credentials and the queue-payload encryption key belong in
# .env.auth, created from .env.auth.example.

# (Optional) Full connection string override:
# DATABASE_URL=mysql+pymysql://zaslon:zaslon_dev@127.0.0.1:3306/zaslon_qds

# --- Quantum Engine Settings ---
# Options: 'cudaq', 'qiskit-aer', or 'reference'
ZASLON_QUANTUM_ENGINE=cudaq
ZASLON_CUDAQ_TARGET=nvidia
ZASLON_CUDAQ_TARGET_OPTION=fp32

# --- Protocol & Security Parameters ---
ZASLON_VERIFICATION_THRESHOLD=0.05
ZASLON_THRESHOLD_SOURCE=CONFIGURED_EXPERIMENTAL
ZASLON_ENTANGLEMENT_DIAGNOSTIC_SHOTS=2048
ZASLON_ENTANGLEMENT_CORRELATION_THRESHOLD=0.90
ZASLON_MAX_DOCUMENT_BYTES=26214400
ZASLON_MAX_SIGNATURE_BYTES=5242880
ZASLON_MAX_PARALLEL_QUANTUM_JOBS=1
ZASLON_EXECUTION_MODE=worker_queue
ZASLON_JOB_WAIT_TIMEOUT_SECONDS=300
ZASLON_JOB_POLL_INTERVAL_SECONDS=0.20
ZASLON_WORKER_ID=quantum-worker-1
ZASLON_WORKER_HEARTBEAT_SECONDS=5
ZASLON_WORKER_STALE_SECONDS=120
ZASLON_WORKER_MAX_ATTEMPTS=2
ZASLON_ALLOW_CUDAQ_CPU_FALLBACK=false

# --- SeQUeNCe network envelope ---
ZASLON_SEQUENCE_ENABLED=true
ZASLON_SEQUENCE_DISTANCE_M=1000
ZASLON_SEQUENCE_ATTENUATION_DB_PER_M=0
ZASLON_SEQUENCE_CLASSICAL_DELAY_PS=5000000
ZASLON_SEQUENCE_SAMPLE_PAIRS=32

# Role-proxy computers use this server-side destination. Never use VITE_* for secrets.
ZASLON_CORE_API_URL=http://127.0.0.1:8000
