# Zaslon-QDS Environment Configuration Template
# SIH 26141 - Quantum-Teleportation-Based Cyber Threat Detection for QDS

# Application Environment
APP_ENV=development
LOG_LEVEL=INFO
SECRET_KEY=zaslon_qds_dev_secret_key_change_in_production_123456789

# Database Configuration (MySQL 8.0)
DATABASE_HOST=mysql-db
DATABASE_PORT=3307
DATABASE_NAME=zaslon_qds
DATABASE_USER=zaslon_user
DATABASE_PASSWORD=zaslon_secure_password
DATABASE_ROOT_PASSWORD=zaslon_root_secure_password

# Quantum Engine Microservice Configuration
QUANTUM_SERVICE_URL=http://quantum-service:8001
CUDA_TARGET=default

# QDS Workload Parameters
TELEPORTATION_COUNT=4096
QUANTUM_BATCH_SIZE=512
VERIFICATION_SAMPLE_RATIO=0.05

# Statistical and Cybersecurity Thresholds
BASELINE_ERROR_RATE=0.01
FISHER_SIGNIFICANCE_ALPHA=0.01
MISMATCH_THRESHOLD_RATIO=0.03
REPLAY_WINDOW_SECONDS=300

# Network & CORS Configuration
API_HOST=0.0.0.0
API_PORT=8000
QUANTUM_HOST=0.0.0.0
QUANTUM_PORT=8001
FRONTEND_PORT=3000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
